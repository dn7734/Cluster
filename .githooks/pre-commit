#!/usr/bin/env python3
"""
AgroCluster Security Shield: Pre-Commit Secret Scanner Hook.
Prevents accidental commits of API keys, private keys, service accounts, and credentials.
"""

import re
import subprocess
import sys

PATTERNS = [
    (r"AIza[0-9A-Za-z-_]{35}", "Google API Key (AIzaSy...)"),
    (r"sk-[0-9A-Za-z]{20,}", "OpenAI / Claude Secret Key (sk-...)"),
    (r"ghp_[0-9A-Za-z]{36}", "GitHub Personal Access Token (ghp_...)"),
    (r"github_pat_[0-9A-Za-z_]{82}", "GitHub Fine-Grained Token"),
    (r"-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----", "Private Cryptographic Key"),
    (r"AKIA[0-9A-Z]{16}", "AWS Access Key ID"),
    (r"xox[baprs]-[0-9a-zA-Z-]{10,}", "Slack Token"),
    (r"\"private_key\":\s*\"-----BEGIN", "Google Service Account Private Key"),
]

def check_staged_diff():
    cmd = ["git", "diff", "--cached", "--unified=0"]
    try:
        diff_output = subprocess.check_output(cmd, text=True, errors="ignore")
    except Exception as e:
        print(f"[PRE-COMMIT] Warning: Could not run git diff: {e}")
        return 0

    violations = []
    current_file = "unknown"

    for line in diff_output.splitlines():
        if line.startswith("+++ b/"):
            current_file = line[6:].strip()
            continue

        if not line.startswith("+") or line.startswith("+++"):
            continue

        added_content = line[1:]

        # Skip example or documentation files
        if current_file.endswith(".example") or current_file.endswith("pre-commit") or "README" in current_file:
            continue

        for pattern, label in PATTERNS:
            matches = re.findall(pattern, added_content)
            if matches:
                violations.append((current_file, label, matches[0][:8] + "..."))

    if violations:
        print("\n" + "=" * 70)
        print("🛑 [SECURITY ALERT] BLOCKED: Detected exposed secrets in staged commit!")
        print("=" * 70)
        for f, label, sample in violations:
            print(f"  • File: {f}")
            print(f"    Secret Type: {label}")
            print(f"    Sample: {sample}")
        print("\nACTION REQUIRED:")
        print("  1. Remove the exposed key or secret from the file.")
        print("  2. Place sensitive keys into .env or environment variables.")
        print("  3. Never commit API keys or private credentials to GitHub.")
        print("=" * 70 + "\n")
        return 1

    return 0

if __name__ == "__main__":
    sys.exit(check_staged_diff())
