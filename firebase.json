{
  "hosting": {
    "site": "agrocluster",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/__pycache__/**",
      "tests/**",
      "dataconnect/**",
      "*.py",
      "*.db",
      "*.log*",
      "Dockerfile",
      "requirements.txt"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}
