# AgroCluster Analytics - Приклад конфігурації оточення
# УВАГА: Ніколи не записуйте реальні ключі в Git! Скопіюйте цей файл у .env:
# cp .env.example .env

# Google Gemini API Key для інтелектуального NLU-координатора (необов'язково)
GEMINI_API_KEY=

# Firebase / Google Cloud Project ID
FIREBASE_PROJECT_ID=gen-lang-client-0227701733
FIREBASE_API_KEY=

# Шлях до сервісного акаунта (зберігається локально або в захищеному сховищі):
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-sa.json
